{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Coding Problem Schema",
  "type": "object",
  "required": [
    "problem_id",
    "title",
    "description",
    "difficulty",
    "topic_tags",
    "constraints",
    "examples",
    "starter_code",
    "solution",
    "test_cases",
    "hints",
    "time_complexity",
    "space_complexity"
  ],
  "properties": {
    "problem_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\$",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "topic_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "output",
          "explanation"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "starter_code": {
      "type": "string",
      "default": ""
    },
    "solution": {
      "type": "string",
      "minLength": 1
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "input",
          "expected_output",
          "is_hidden"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "expected_output": {
            "type": "string"
          },
          "is_hidden": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 3
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "time_complexity": {
      "type": "string",
      "minLength": 1
    },
    "space_complexity": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}