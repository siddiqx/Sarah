{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Curriculum Lesson Schema",
  "type": "object",
  "required": [
    "lesson_id",
    "topic_id",
    "title",
    "description",
    "blocks"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\$",
      "minLength": 1,
      "maxLength": 100
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\$",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "block.schema.json"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}