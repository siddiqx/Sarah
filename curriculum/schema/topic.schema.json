{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Curriculum Topic Schema",
  "type": "object",
  "required": [
    "topic_id",
    "day_number",
    "title",
    "description",
    "difficulty",
    "learning_objectives",
    "prerequisite_topic_ids",
    "related_skills",
    "mastery_criteria",
    "revision_criteria"
  ],
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\$",
      "minLength": 1,
      "maxLength": 100
    },
    "day_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "learning_objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "prerequisite_topic_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "related_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mastery_criteria": {
      "type": "string",
      "minLength": 1
    },
    "revision_criteria": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}