{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "Curriculum Phase",
  "type": "object",
  "required": [
    "number",
    "title",
    "description",
    "days"
  ],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "days": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}