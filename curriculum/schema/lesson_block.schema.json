{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "Lesson Block",
  "type": "object",
  "required": [
    "block_type",
    "content",
    "order"
  ],
  "properties": {
    "block_type": {
      "type": "string",
      "enum": [
        "concept",
        "worked_example",
        "code_example",
        "prediction",
        "trace",
        "fill_code",
        "ordering",
        "matching",
        "comparison",
        "debugging",
        "simulation",
        "knowledge_check",
        "practical_application",
        "summary",
        "revision_checkpoint"
      ]
    },
    "content": {
      "type": "object"
    },
    "order": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}