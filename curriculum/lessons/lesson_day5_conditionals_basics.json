      "question": "What does this print? x = 0; if x: print("Yes") else: print("No")",
      "type": "multiple_choice",
      "options": ["Yes", "No", "Error", "Nothing"],
      "correct_answer": "No",
      "explanation": "0 is falsy, so the else branch executes.",
      "difficulty": "easy"
    },
    {
