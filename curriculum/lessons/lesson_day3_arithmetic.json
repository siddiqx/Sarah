      "starter_code": "a = 15\nb = 4\n# Print all seven operations\n",
      "solution": "a = 15\nb = 4\nprint(f"{a} + {b} = {a + b}")\nprint(f"{a} - {b} = {a - b}")\nprint(f"{a} * {b} = {a * b}")\nprint(f"{a} / {b} = {a / b}")\nprint(f"{a} // {b} = {a // b}")\nprint(f"{a} % {b} = {a % b}")\nprint(f"{a} ** {b} = {a ** b}")",
