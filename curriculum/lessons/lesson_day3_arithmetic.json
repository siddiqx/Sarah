      "content": {
        "title": "Seven Arithmetic Operators",
        "explanation": "Python provides seven arithmetic operators for mathematical computations. Each has a specific purpose and behavior.",
        "key_points": [
          "+ : addition",
          "- : subtraction",
          "* : multiplication",
          "/ : true division (always returns float)",
          "// : floor division (rounds down to nearest integer)",
          "% : modulo (remainder after division)",
          "** : exponentiation (power)"
        ]
      }
    },
    {
      "type": "code_example",
      "order": 2,
      "estimated_minutes": 5,
      "content": {
        "title": "Arithmetic Examples",
        "code": "a = 17\nb = 5\n\nprint(a + b)   # 22\nprint(a - b)   # 12\nprint(a * b)   # 85\nprint(a / b)   # 3.4 (float)\nprint(a // b)  # 3 (integer)\nprint(a % b)   # 2 (remainder)\nprint(a ** b)  # 1419857 (17^5)",
        "language": "python",
        "explanation": "Notice how / always returns float, while // returns integer. Modulo gives the remainder."
      }
    },
    {
      "type": "output_prediction",
      "order": 3,
      "estimated_minutes": 5,
      "content": {
        "title": "Division vs Floor Division",
        "code": "print(10 / 3)\nprint(10 // 3)\nprint(-10 // 3)\nprint(10 % 3)\nprint(-10 % 3)",
        "question": "What are the outputs?",
        "options": [
          "3.33, 3, -3, 1, 2",
          "3.33, 3, -4, 1, 2",
          "3.33, 3, -3, 1, -2",
          "3, 3, -3, 1, 2"
        ],
        "correct_answer": "3.33, 3, -4, 1, 2",
        "explanation": "Floor division rounds DOWN (toward negative infinity). -10//3 = -4. Modulo always returns non-negative when divisor is positive."
      }
    },
