      "content": {
        "title": "Key Takeaways",
        "points": [
          "Case: upper(), lower(), title(), capitalize()",
          "Whitespace: strip(), lstrip(), rstrip()",
          "Replace: replace(old, new[, count])",
          "Split/Join: split([sep]), sep.join(iterable)",
          "All return NEW strings - assign to keep changes"
        ]
      }
