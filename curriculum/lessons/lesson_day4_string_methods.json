  ],
  "exercises": [
    {
      "id": "ex_day4_string_methods",
      "title": "Text Cleanup",
      "description": "Clean the messy string: "  \t  HeLLo, WORld!  \n" - strip whitespace, make title case, replace comma with semicolon.",
      "starter_code": "messy = "  \\t  HeLLo, WORld!  \\n"\n# Clean it step by step\n",
      "solution": "messy = "  \\t  HeLLo, WORld!  \\n"\nclean = messy.strip().title().replace(",", ";")\nprint(repr(clean))  # 'Hello; World!'",
      "tests": [
        "assert "Hello; World!" in output"
      ],
      "hints": ["Chain: strip() -> title() -> replace()"],
      "difficulty": "easy",
      "time_limit_seconds": 30
    },
    {
      "id": "ex_day4_immutability",
      "title": "Immutability Demo",
      "description": "Demonstrate string immutability: create s = "hello", try to change s[0] = "H" (will error), show correct way.",
      "starter_code": "s = "hello"\n# Try s[0] = "H" - what happens?\n# Show correct way\n",
      "solution": "s = "hello"\ntry:\n    s[0] = "H"\nexcept TypeError as e:\n    print(f"Error: {e}")\n\n# Correct way\ns = s[0].upper() + s[1:]\nprint(s)  # Hello",
      "tests": [
        "assert "Error" in output",
        "assert "Hello" in output"
      ],
      "hints": ["Strings cannot be modified in place. Create new string."],
      "difficulty": "easy",
      "time_limit_seconds": 30
    }
  ],
