{
  "id": "lesson_day4_string_methods",
  "day_number": 4,
  "title": "String Methods: Transformation and Analysis",
  "phase_id": "a",
  "estimated_minutes": 45,
  "difficulty": "beginner",
  "objectives": [
    "Use case conversion methods: upper(), lower(), title(), capitalize()",
    "Trim whitespace with strip(), lstrip(), rstrip()",
    "Replace substrings with replace()",
    "Split and join with split() and join()",
    "Understand method chaining and immutability"
  ],
  "prerequisites": ["lesson_day4_string_basics"],
  "blocks": [
    {
      "type": "concept_explanation",
      "order": 1,
      "estimated_minutes": 5,
      "content": {
        "title": "Case Conversion Methods",
        "explanation": "Strings have methods to change letter case. These return NEW strings - the original is unchanged (immutability).",
        "key_points": [
          "upper() - all uppercase",
          "lower() - all lowercase",
          "title() - first letter of each word capitalized",
          "capitalize() - only first character capitalized"
        ]
      }
    },
    {
      "type": "code_example",
      "order": 2,
      "estimated_minutes": 5,
      "content": {
        "title": "Case Conversion Examples",
        "code": "text = "hello WORLD"\nprint(text.upper())      # HELLO WORLD\nprint(text.lower())      # hello world\nprint(text.title())      # Hello World\nprint(text.capitalize()) # Hello world\n\n# Original unchanged\nprint(text)              # hello WORLD",
        "language": "python",
        "explanation": "All methods return new strings. Original 'text' remains 'hello WORLD'."
      }
    },
    {
      "type": "concept_explanation",
      "order": 3,
      "estimated_minutes": 5,
      "content": {
        "title": "Whitespace and Replacement",
        "explanation": "strip() removes leading/trailing whitespace. replace() substitutes substrings. Both return new strings.",
        "key_points": [
          "strip() - both ends",
          "lstrip() - left only",
          "rstrip() - right only",
          "replace(old, new) - all occurrences",
          "replace(old, new, count) - limited replacements"
        ]
      }
    },
    {
      "type": "code_example",
      "order": 4,
      "estimated_minutes": 5,
      "content": {
        "title": "Whitespace and Replace Examples",
        "code": "messy = "  hello world  "\nprint(repr(messy.strip()))    # 'hello world'\nprint(repr(messy.lstrip()))   # 'hello world  '\nprint(repr(messy.rstrip()))   # '  hello world'\n\ntext = "I like cats"\nprint(text.replace("cats", "dogs"))  # I like dogs\nprint(text.replace(" ", "-"))        # I-like-cats",
        "language": "python",
        "explanation": "repr() shows invisible whitespace. replace() without count replaces all occurrences."
      }
    },
    {
      "type": "concept_explanation",
      "order": 5,
      "estimated_minutes": 5,
      "content": {
        "title": "Split and Join",
        "explanation": "split() breaks a string into a list. join() combines a list into a string. They are inverses.",
        "key_points": [
          "split() - splits on whitespace by default",
          "split(sep) - splits on specific separator",
          "join(iterable) - joins with string as separator",
          "" ".join(words) - space-separated",
          "",".join(items) - comma-separated"
        ]
      }
    },
    {
      "type": "code_example",
      "order": 6,
      "estimated_minutes": 5,
      "content": {
        "title": "Split and Join Examples",
        "code": "sentence = "The quick brown fox"\nwords = sentence.split()\nprint(words)              # ['The', 'quick', 'brown', 'fox']\nprint(" ".join(words))    # The quick brown fox\n\ncsv = "apple,banana,cherry"\nitems = csv.split(",")\nprint(items)              # ['apple', 'banana', 'cherry']\nprint("|".join(items))    # apple|banana|cherry",
        "language": "python",
        "explanation": "split() without args handles multiple spaces. join() requires all elements to be strings."
      }
    },
    {
      "type": "fill_in_code",
      "order": 7,
      "estimated_minutes": 5,
      "content": {
        "title": "Method Chaining",
        "code": "raw = "  HELLO world  "\n# Chain methods: strip, lower, replace world with python\nclean = _____\nprint(repr(clean))  # 'hello python'",
        "blanks": [
          {"placeholder": "_____", "answer": "raw.strip().lower().replace("world", "python")", "hint": "Chain methods left to right"}
        ],
        "solution": "clean = raw.strip().lower().replace("world", "python")"
      }
    },
    {
      "type": "debugging_exercise",
      "order": 8,
      "estimated_minutes": 5,
      "content": {
        "title": "Why Did It Not Change?",
        "buggy_code": "name = "alice"\nname.upper()\nprint(name)  # Still prints 'alice'",
        "error_message": "Logical error - output is 'alice' not 'ALICE'",
        "task": "Fix the code to actually change the variable",
        "hint": "String methods return new strings. You must assign the result.",
        "solution": "name = "alice"\nname = name.upper()\nprint(name)  # ALICE"
      }
    },
    {
      "type": "knowledge_check",
      "order": 9,
